PORT=5000
NODE_ENV=development
MONGODB_URI=
# Supabase PostgreSQL Connection String (Transaction Pooler - Port 6543 recommended for Node/Express)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
JWT_SECRET=
FRONTEND_URL=http://localhost:3000

# Owner account created by `npm run seed` (password is hashed before it is stored)
ADMIN_EMAIL=
ADMIN_PASSWORD=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Same value as REVALIDATE_SECRET in frontend/.env.local (any long random string). Lets the API refresh the website cache when an admin saves.
REVALIDATE_SECRET=

# Quick Enquiry -> WhatsApp. Number that receives the enquiries (10-digit Indian number, or with country code).
WHATSAPP_NUMBER=8249314191
# Leave these three empty to use the fallback (the visitor sends the WhatsApp message themselves).
# Fill them (Meta WhatsApp Business Cloud API) and the backend sends the message itself.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Optional: name of an approved message template with ONE body variable. Without it a plain text message is sent,
# which WhatsApp only delivers if the receiving number messaged the business number in the last 24 hours.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
